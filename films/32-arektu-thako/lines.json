[{"t0": 24.8, "t1": 29.55, "text": "বিকেলটা আজ কেমন যেন থেমে আছে", "n": 2}, {"t0": 30.65, "t1": 35.25, "text": "জানালাতে বৃষ্টি নামে ধীরে", "n": 2}, {"t0": 36.6, "t1": 41.0, "text": "তোমার বলা কথাগুলো মনে আছে", "n": 2}, {"t0": 41.9, "t1": 45.38, "text": "তুমি এখন অনেক দূরে", "n": 2}, {"t0": 45.4, "t1": 49.0, "text": "চায়ের কাপে তোমার ছোঁয়া রয়ে যায়", "n": 1}, {"t0": 49.4, "t1": 52.9, "text": "টেবিলজুড়ে পুরোনো ছবি", "n": 1}, {"t0": 53.4, "t1": 57.0, "text": "সন্ধ্যা হলে তোমার কথাই মনে হয়", "n": 1}, {"t0": 57.4, "t1": 61.1, "text": "কেন যে আজও তোমায় ভাবি", "n": 1}, {"t0": 72.6, "t1": 74.98, "text": "জানি তোমার যেতে হবে,", "n": 2}, {"t0": 75.0, "t1": 78.2, "text": "জানি সময় থামবে না।", "n": 2}, {"t0": 78.65, "t1": 81.05, "text": "তবু কেন এই মনটা", "n": 2}, {"t0": 81.15, "t1": 83.75, "text": "বিদায় দিতে চায় না?", "n": 2}, {"t0": 84.5, "t1": 87.3, "text": "যাওয়ার আগে শেষবার শুধু", "n": 2}, {"t0": 87.65, "t1": 90.4, "text": "একটা কথা বলব তোমায়...", "n": 2}, {"t0": 90.95, "t1": 93.15, "text": "আরেকটু থাকো,", "n": 2}, {"t0": 93.2, "t1": 96.2, "text": "এই সন্ধ্যাটা শেষ না হোক।", "n": 2}, {"t0": 96.55, "t1": 98.4, "text": "আরেকটু থাকো,", "n": 2}, {"t0": 98.5, "t1": 101.7, "text": "কিছু কথা বলা বাকি থাক।", "n": 2}, {"t0": 102.5, "t1": 105.1, "text": "কালকে তুমি দূরে যাবে,", "n": 2}, {"t0": 105.3, "t1": 108.6, "text": "আজকে শুধু কাছে থাকো।", "n": 2}, {"t0": 108.9, "t1": 111.8, "text": "সবকিছুই বদলে যাক,", "n": 2}, {"t0": 112.0, "t1": 115.1, "text": "এই মুহূর্তটা না বদলাক।", "n": 2}, {"t0": 115.2, "t1": 118.1, "text": "আরেকটু থাকো...", "n": 2}, {"t0": 120.6, "t1": 123.75, "text": "আরেকটু থাকো...", "n": 2}, {"t0": 139.5, "t1": 142.45, "text": "তোমায় ধরে রাখব না আমি,", "n": 2}, {"t0": 142.8, "t1": 145.78, "text": "তোমার পথটা তোমারই।", "n": 2}, {"t0": 145.8, "t1": 147.13, "text": "শুধু আজকে মনে হচ্ছে,", "n": 2}, {"t0": 147.15, "t1": 149.05, "text": "সময়টা বড় তাড়াতাড়ি।", "n": 2}, {"t0": 152.5, "t1": 155.13, "text": "যদি আবার দেখা হয়,", "n": 2}, {"t0": 155.15, "t1": 