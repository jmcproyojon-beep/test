[{"t0": 8.0, "t1": 9.9, "text": "একটা জায়গায় যাওয়ার কথা ছিল,"}, {"t0": 10.0, "t1": 11.9, "text": "মনে আছে?"}, {"t0": 12.0, "t1": 13.9, "text": "খুব দূরে কোথাও না।"}, {"t0": 14.0, "t1": 15.9, "text": "তুমি বলেছিলে,"}, {"t0": 16.0, "t1": 17.9, "text": "\"একদিন সময় করে যাব।\""}, {"t0": 18.0, "t1": 19.9, "text": "তারপর..."}, {"t0": 20.0, "t1": 21.9, "text": "সময় হলো।"}, {"t0": 22.0, "t1": 27.9, "text": "যাওয়া হলো না।"}, {"t0": 28.0, "t1": 31.07, "text": "তোমার ফোনে রাখা ছিল"}, {"t0": 31.17, "t1": 34.23, "text": "কত জায়গার ছবি।"}, {"t0": 34.33, "t1": 37.4, "text": "কোথায় গেলে কী খাব আমরা,"}, {"t0": 37.5, "t1": 40.57, "text": "সবই জানতে তুমি।"}, {"t0": 40.67, "t1": 43.73, "text": "আমি বলতাম, \"দেখা যাবে,"}, {"t0": 43.83, "t1": 46.9, "text": "আগে ছুটিটা পাই।\""}, {"t0": 47.0, "t1": 50.07, "text": "তুমি বলতে, \"সবকিছুতেই"}, {"t0": 50.17, "t1": 53.23, "text": "এত দেরি করো কেন?\""}, {"t0": 53.33, "t1": 56.4, "text": "এখন ছুটি পেলেই ভাবি,"}, {"t0": 56.5, "t1": 59.57, "text": "কোথাও ঘুরে আসি।"}, {"t0": 59.67, "t1": 62.73, "text": "তারপর আর ঠিক করা হয় না,"}, {"t0": 62.83, "t1": 65.9, "text": "কোন শহরে যাব আমি।"}, {"t0": 66.0, "t1": 69.9, "text": "আমরা কত কিছু ভেবেছি,"}, {"t0": 70.0, "t1": 73.9, "text": "কত কিছু বলা।"}, {"t0": 74.0, "t1": 77.9, "text": "কিছু কথা শেষ হয়েছে,"}, {"t0": 78.0, "t1": 83.9, "text": "কিছু রয়ে গেছে আধখানা।"}, {"t0": 84.0, "t1": 86.9, "text": "আমাদের আর যাওয়া হলো না,"}, {"t0": 87.0, "t1": 89.9, "text": "সেই জায়গাটায়।"}, {"t0": 90.0, "t1": 92.9, "text": "আমাদের আর বসা হলো না,"}, {"t0": 93.0, "t1": 95.9, "text": "একটা বিকেল কাটায়।"}, {"t0": 96.0, "t1": 98.9, "text": "আমাদের আর বলা হলো না,"}, {"t0": 99.0, "t1": 101.9, "text": "কত কথা ছিল।"}, {"t0": 102.0, "t1": 104.9, "text": "সবকিছুই ঠিক ছিল যেন,"}, {"t0": 105.0, "t1": 109.9, "text": "শুধু আমরা ছিলাম না।"}, {"t0": 110.0, "t1": 112.53, "text": "তুমি বলতে, \"একটা বাড়ি"}, {"t0": 112.62, "t1": 115.15, "text": "হবে ছোট্ট কোনোখানে।"}, {"t0": 115.25, "t1": 117.78, "text": "জানালাটা বড় হবে,"}, {"t0": 117.88, "t1": 120.4, "text": "রোদ আসবে সকালে।\""}, {"t0": 120.5, "t1": 123.03, "text": "আমি বলতাম, \"বই রাখব,"}, {"t0": 123.12, "t1": 125.65, "text": "একটা তাকের ওপর।\""}, {"t0": 125.75, "t1": 128.28, "text": "তুমি বলতে, \"গাছ রাখব,"}, {"t0": 128.38, "t1": 130.9, "text": "বারান্দার দুই কোণে।\""}, {"t0": 131.0, "t1": 133.53, "text": "এখন যখন বাড়ি দেখি,"}, {"t0": 133.62, "t1": 136.15, "text": "জানালাগুলো দেখি।"}, {"t0": 136.25, "t1": 138.78, "text": "কেমন যেন মনে পড়ে,"}, {"t0": 138.88, "t1": 141.4, "text": "কী কী ভেবেছিলে তুমি।"}, {"t0": 141.5, "t1": 144.03, "text": "তোমার সঙ্গে সেই বাড়িটা"}, {"t0": 144.12, "t1": 146.65, "text": "কখনো গড়া হলো না।"}, {"t0": 146.75, "t1": 149.28, "text": "তবু কোথাও বড় জানালা"}, {"t0": 149.38, "t1": 151.9, "text": "দেখলে থেমে যাই।"}, {"t0": 152.0, "t1": 153.9, "text": "মানুষ শুধু মানুষ হারায় না,"}, {"t0": 154.0, "t1": 155.9, "text": "হারায় কত সম্ভাবনা।"}, {"t0": 156.0, "t1": 157.9, "text": "যে দিনগুলো আসেনি আর,"}, {"t0": 158.0, "t1": 159.9, "text": "তাদেরও থাকে ঠিকানা।"}, {"t0": 160.0, "t1": 162.4, "text": "আমাদের আর যাওয়া হলো না,"}, {"t0": 162.5, "t1": 164.9, "text": "সেই জায়গাটায়।"}, {"t0": 165.0, "t1": 167.4, "text": "আমাদের আর বসা হলো না,"}, {"t0": 167.5, "t1": 169.9, "text": "একটা বিকেল কাটায়।"}, {"t0": 170.0, "t1": 172.4, "text": "আমাদের আর বলা হলো না,"}, {"t0": 172.5, "t1": 174.9, "text": "কত কথা ছিল।"}, {"t0": 175.0, "t1": 177.4, "text": "সবকিছুই ঠিক ছিল যেন,"}, {"t0": 177.5, "t1": 181.9, "text": "শুধু আমরা ছিলাম না।"}, {"t0": 182.0, "t1": 184.4, "text": "সেদিন একা একটা জায়গায় গেলাম।"}, {"t0": 184.5, "t1": 186.9, "text": "যেখানে যাওয়ার কথা ছিল"}, {"t0": 187.0, "t1": 189.4, "text": "আমাদের দুজনের।"}, {"t0": 189.5, "t1": 191.9, "text": "খুব সুন্দর ছিল।"}, {"t0": 192.0, "t1": 194.4, "text": "তোমাকে ছবি পাঠাইনি।"}, {"t0": 194.5, "t1": 196.9, "text": "কারণ..."}, {"t0": 197.0, "t1": 199.4, "text": "কিছু সুন্দর জিনিস"}, {"t0": 199.5, "t1": 203.9, "text": "নিজের কাছেও রাখা যায়।"}, {"t0": 204.0, "t1": 206.9, "text": "আমাদের আর যাওয়া হলো না,"}, {"t0": 207.0, "t1": 209.9, "text": "সেই দিনগুলোয়।"}, {"t0": 210.0, "t1": 212.9, "text": "তবু জীবন থেমে থাকেনি,"}, {"t0": 213.0, "t1": 215.9, "text": "নতুন পথে বয়ে যায়।"}, {"t0": 216.0, "t1": 218.9, "text": "আমাদের আর বলা হলো না,"}, {"t0": 219.0, "t1": 221.9, "text": "যা বলার ছিল।"}, {"t0": 222.0, "t1": 224.9, "text": "তবু যতটুকু সত্যি ছিল,"}, {"t0": 225.0, "t1": 227.9, "text": "সেটুকু মিথ্যে নয়।"}, {"t0": 228.0, "t1": 230.9, "text": "আমাদের আর যাওয়া হলো না,"}, {"t0": 231.0, "t1": 233.9, "text": "একসঙ্গে কোথাও।"}, {"t0": 234.0, "t1": 236.9, "text": "তবু আমি হাঁটতে শিখেছি,"}, {"t0": 237.0, "t1": 243.9, "text": "নিজের পথেও।"}, {"t0": 244.0, "t1": 248.4, "text": "আজকে একটা নতুন জায়গার"}, {"t0": 248.5, "t1": 252.9, "text": "ছবি তুলে রাখলাম।"}, {"t0": 253.0, "t1": 257.4, "text": "কাউকে পাঠানোর জন্য না।"}, {"t0": 257.5, "t1": 260.4, "text": "আবার যাব বলে।"}]