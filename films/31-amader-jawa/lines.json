[{"t0": 12.8, "t1": 16.3, "text": "একটা জায়গায় যাওয়ার কথা ছিল,", "n": 4}, {"t0": 16.8, "t1": 18.35, "text": "মনে আছে?", "n": 3}, {"t0": 18.65, "t1": 21.05, "text": "খুব দূরে কোথাও না।", "n": 3}, {"t0": 21.3, "t1": 22.83, "text": "তুমি বলেছিলে,", "n": 4}, {"t0": 22.85, "t1": 26.15, "text": "\"একদিন সময় করে যাব।\"", "n": 4}, {"t0": 26.85, "t1": 28.15, "text": "তারপর...", "n": 4}, {"t0": 28.35, "t1": 30.25, "text": "সময় হলো।", "n": 4}, {"t0": 31.45, "t1": 34.05, "text": "যাওয়া হলো না।", "n": 4}, {"t0": 40.1, "t1": 42.23, "text": "তোমার ফোনে রাখা ছিল", "n": 4}, {"t0": 42.25, "t1": 44.7, "text": "কত জায়গার ছবি।", "n": 4}, {"t0": 47.0, "t1": 49.8, "text": "কোথায় গেলে কী খাব আমরা,", "n": 4}, {"t0": 49.85, "t1": 52.25, "text": "সবই জানতে তুমি।", "n": 4}, {"t0": 53.1, "t1": 55.38, "text": "আমি বলতাম, \"দেখা যাবে,", "n": 4}, {"t0": 55.4, "t1": 57.48, "text": "আগে ছুটিটা পাই।\"", "n": 4}, {"t0": 57.5, "t1": 59.88, "text": "তুমি বলতে, \"সবকিছুতেই", "n": 4}, {"t0": 59.9, "t1": 62.2, "text": "এত দেরি করো কেন?\"", "n": 3}, {"t0": 64.3, "t1": 66.5, "text": "এখন ছুটি পেলেই ভাবি,", "n": 4}, {"t0": 66.6, "t1": 68.2, "text": "কোথাও ঘুরে আসি।", "n": 4}, {"t0": 68.7, "t1": 71.23, "text": "তারপর আর ঠিক করা হয় না,", "n": 4}, {"t0": 71.25, "t1": 74.6, "text": "কোন শহরে যাব আমি।", "n": 4}, {"t0": 74.9, "t1": 77.13, "text": "আমরা কত কিছু ভেবেছি,", "n": 4}, {"t0": 77.15, "t1": 78.9, "text": "কত কিছু বলা।", "n": 4}, {"t0": 78.95, "t1": 81.25, "text": "কিছু কথা শেষ হয়েছে,", "n": 4}, {"t0": 81.3, "t1": 85.0, "text": "কিছু রয়ে গেছে আধখানা।", "n": 4}, {"t0": 85.1, "t1": 88.0, "text": "আমাদের আর যাওয়া হলো না,", "n": 3}, {"t0": 88.1, "t1": 90.0, "text": "সেই জায়গাটায়।", "n": 3}, {"t0": 92.15, "t1": 94.8, "text": "আমাদের আর বসা হলো না,", "n": 2}, {"t0": 95.8, "t1": 98.3, "text": "একটা বিকেল কাটায়।", "n": 2}, {"t0": 99.0, "t1": 101.48, "text": "আমাদের আর বলা হলো না,", "n": 2}, {"t0": 101.5, "t1": 103.43, "text": "কত কথা ছিল।", "n": 2}, {"t0": 103.45, "t1": 106.95, "text": "সবকিছুই ঠিক ছিল যেন,", "n": 1}, {"t0": 107.4, "t1": 110.45, "text": "শুধু আমরা ছিলাম না।", "n": 2}, {"t0": 110.9, "t1": 114.03, "text": "তুমি বলতে, \"একটা বাড়ি", "n": 1}, {"t0": 114.05, "t1": 115.65, "text": "হবে ছোট্ট কোনোখানে।", "n": 2}, {"t0": 115.7, "t1": 117.65, "text": "জানালাটা বড় হবে,", "n": 2}, {"t0": 117.7, "t1": 119.75, "text": "রোদ আসবে সকালে।\"", "n": 2}, {"t0": 120.55, "t1": 122.68, "text": "আমি বলতাম, \"বই রাখব,", "n": 2}, {"t0": 122.7, "t1": 124.13, "text": "একটা তাকের ওপর।\"", "n": 2}, {"t0": 124.15, "t1": 125.9, "text": "তুমি বলতে, \"গাছ রাখব,", "n": 2}, {"t0": 125.95, "t1": 127.8, "text": "বারান্দার দুই কোণে।\"", "n": 2}, {"t0": 128.0, "t1": 130.03, "text": "এখন যখন বাড়ি দেখি,", "n": 2}, {"t0": 130.05, "t1": 131.7, "text": "জানালাগুলো দেখি।", "n": 2}, {"t0": 131.75, "t1": 133.08, "text": "কেমন যেন মনে পড়ে,", "n": 2}, {"t0": 133.1, "t1": 135.1, "text": "কী কী ভেবেছিলে তুমি।", "n": 2}, {"t0": 135.55, "t1": 137.08, "text": "তোমার সঙ্গে সেই বাড়িটা", "n": 1}, {"t0": 137.1, "t1": 139.08, "text": "কখনো গড়া হলো না।", "n": 2}, {"t0": 139.1, "t1": 140.98, "text": "তবু কোথাও বড় জানালা", "n": 2}, {"t0": 141.0, "t1": 142.93, "text": "দেখলে থেমে যাই।", "n": 2}, {"t0": 142.95, "t1": 146.08, "text": "মানুষ শুধু মানুষ হারায় না,", "n": 2}, {"t0": 146.1, "t1": 149.08, "text": "হারায় কত সম্ভাবনা।", "n": 2}, {"t0": 149.1, "t1": 152.08, "text": "যে দিনগুলো আসেনি আর,", "n": 2}, {"t0": 152.1, "t1": 155.1, "text": "তাদেরও থাকে ঠিকানা।", "n": 2}, {"t0": 155.45, "t1": 158.58, "text": "আমাদের আর যাওয়া হলো না,", "n": 2}, {"t0": 158.6, "t1": 161.35, "text": "সেই জায়গাটায়।", "n": 2}, {"t0": 161.7, "t1": 165.48, "text": "আমাদের আর বসা হলো না,", "n": 2}, {"t0": 165.5, "t1": 168.0, "text": "একটা বিকেল কাটায়।", "n": 1}, {"t0": 169.1, "t1": 171.88, "text": "আমাদের আর বলা হলো না,", "n": 2}, {"t0": 171.9, "t1": 174.2, "text": "কত কথা ছিল।", "n": 1}, {"t0": 175.0, "t1": 178.1, "text": "সবকিছুই ঠিক ছিল যেন,", "n": 2}, {"t0": 178.25, "t1": 180.75, "text": "শুধু আমরা ছিলাম না।", "n": 2}, {"t0": 182.5, "t1": 185.1, "text": "সেদিন একা একটা জায়গায় গেলাম।", "n": 2}, {"t0": 185.9, "t1": 187.9, "text": "যেখানে যাওয়ার কথা ছিল", "n": 2}, {"t0": 188.6, "t1": 190.0, "text": "আমাদের দুজনের।", "n": 2}, {"t0": 191.0, "t1": 192.75, "text": "খুব সুন্দর ছিল।", "n": 2}, {"t0": 193.25, "t1": 195.25, "text": "তোমাকে ছবি পাঠাইনি।", "n": 2}, {"t0": 196.3, "t1": 197.7, "text": "কারণ...", "n": 2}, {"t0": 198.1, "t1": 200.2, "text": "কিছু সুন্দর জিনিস", "n": 2}, {"t0": 200.85, "t1": 203.1, "text": "নিজের কাছেও রাখা যায়।", "n": 2}, {"t0": 203.9, "t1": 207.5, "text": "আমাদের আর যাওয়া হলো না,", "n": 2}, {"t0": 207.85, "t1": 210.75, "text": "সেই দিনগুলোয়।", "n": 2}, {"t0": 211.0, "t1": 214.0, "text": "তবু জীবন থেমে থাকেনি,", "n": 2}, {"t0": 214.1, "t1": 217.5, "text": "নতুন পথে বয়ে যায়।", "n": 2}, {"t0": 218.0, "t1": 221.0, "text": "আমাদের আর বলা হলো না,", "n": 2}, {"t0": 221.05, "t1": 224.4, "text": "যা বলার ছিল।", "n": 2}, {"t0": 225.0, "t1": 227.68, "text": "তবু যতটুকু সত্যি ছিল,", "n": 2}, {"t0": 227.7, "t1": 230.1, "text": "সেটুকু মিথ্যে নয়।", "n": 2}, {"t0": 232.2, "t1": 235.3, "text": "আমাদের আর যাওয়া হলো না,", "n": 2}, {"t0": 235.65, "t1": 238.15, "text": "একসঙ্গে কোথাও।", "n": 2}, {"t0": 238.6, "t1": 241.5, "text": "তবু আমি হাঁটতে শিখেছি,", "n": 2}, {"t0": 241.65, "t1": 244.35, "text": "নিজের পথেও।", "n": 2}, {"t0": 246.3, "t1": 250.1, "text": "আজকে একটা নতুন জায়গার", "n": 2}, {"t0": 250.75, "t1": 253.25, "text": "ছবি তুলে রাখলাম।", "n": 2}, {"t0": 253.4, "t1": 257.9, "text": "কাউকে পাঠানোর জন্য না।", "n": 2}, {"t0": 260.0, "t1": 263.7, "text": "আবার যাব বলে।", "n": 2}]