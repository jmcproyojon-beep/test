{"0.0": [{"t0": 12.7, "t1": 16.8, "text": "একটা জায়গায় যাওয়ার কথা ছিল,"}, {"t0": 16.8, "t1": 18.2, "text": "মনে আছে?"}, {"t0": 18.5, "t1": 21.0, "text": "খুব দূরে কোথাও না।"}, {"t0": 21.3, "t1": 22.6, "text": "তুমি বলেছিলে,"}, {"t0": 22.8, "t1": 26.5, "text": "\"একদিন সময় করে যাব।\""}, {"t0": 26.8, "t1": 28.1, "text": "তারপর..."}, {"t0": 28.3, "t1": 30.0, "text": "সময় হলো।"}], "30.0": [{"t0": 1.3, "t1": 4.1, "text": "যাওয়া হলো না।"}, {"t0": 9.8, "t1": 12.3, "text": "তোমার ফোনে রাখা ছিল"}, {"t0": 12.3, "t1": 14.8, "text": "কত জায়গার ছবি।"}, {"t0": 16.9, "t1": 20.0, "text": "কোথায় গেলে কী খাব আমরা,"}, {"t0": 20.0, "t1": 22.3, "text": "সবই জানতে তুমি।"}, {"t0": 22.8, "t1": 25.4, "text": "আমি বলতাম, \"দেখা যাবে,"}, {"t0": 25.4, "t1": 27.5, "text": "আগে ছুটিটা পাই।\""}, {"t0": 27.5, "t1": 30.0, "text": "তুমি বলতে, \"সবকিছুতেই"}], "60.0": [{"t0": 0.0, "t1": 2.1, "text": "এত দেরি করো কেন?"}, {"t0": 4.3, "t1": 6.5, "text": "এখন ছুটি পেলেই ভাবি,"}, {"t0": 6.6, "t1": 8.2, "text": "কোথাও ঘুরে আসি।"}, {"t0": 8.3, "t1": 11.1, "text": "তারপর আর ঠিক করা হয় না,"}, {"t0": 11.2, "t1": 14.3, "text": "কোন শহরে যাব আমি।"}, {"t0": 15.1, "t1": 17.2, "text": "আমরা কত কিছু ভেবেছি,"}, {"t0": 17.2, "t1": 18.8, "text": "কত কিছু বলা।"}, {"t0": 18.9, "t1": 21.3, "text": "কিছু কথা শেষ হয়েছে,"}, {"t0": 21.4, "t1": 25.0, "text": "কিছু রয়ে গেছে আধখানা।"}, {"t0": 25.1, "t1": 28.0, "text": "আমাদের আর যাওয়া হলো না,"}, {"t0": 28.1, "t1": 30.0, "text": "সেই জায়গাটায়।"}]}