{"7.5": [{"t0": 5.4, "t1": 8.8, "text": "একটা জায়গায় যাওয়ার কথা ছিল,"}, {"t0": 9.0, "t1": 10.6, "text": "মনে আছে?"}, {"t0": 10.8, "t1": 13.3, "text": "খুব দূরে কোথাও না।"}, {"t0": 13.8, "t1": 15.4, "text": "তুমি বলেছিলে,"}, {"t0": 15.4, "t1": 18.3, "text": "\"একদিন সময় করে যাব।\""}, {"t0": 19.4, "t1": 20.8, "text": "তারপর..."}, {"t0": 21.4, "t1": 23.3, "text": "সময় হলো।"}, {"t0": 24.1, "t1": 26.5, "text": "যাওয়া হলো না।"}], "37.5": [{"t0": 2.7, "t1": 4.6, "text": "তোমার ফোনে রাখা ছিল"}, {"t0": 4.7, "t1": 7.0, "text": "কত জায়গার ছবি।"}, {"t0": 9.3, "t1": 12.1, "text": "কোথায় গেলে কী খাব আমরা,"}, {"t0": 12.2, "t1": 14.4, "text": "সবই জানতে তুমি।"}, {"t0": 15.9, "t1": 17.8, "text": "আমি বলতাম, \"দেখা যাবে,"}, {"t0": 17.9, "t1": 19.8, "text": "আগে ছুটিটা পাই।\""}, {"t0": 20.1, "t1": 22.5, "text": "তুমি বলতে, \"সবকিছুতেই"}, {"t0": 22.6, "t1": 24.8, "text": "এত দেরি করো কেন?\""}, {"t0": 26.7, "t1": 28.8, "text": "এখন ছুটি পেলেই ভাবি,"}, {"t0": 28.9, "t1": 30.0, "text": "কোথাও ঘুরে আসি।"}], "52.5": [{"t0": 0.3, "t1": 3.2, "text": "আমি বলতাম, \"দেখা যাবে,"}, {"t0": 3.2, "t1": 5.0, "text": "আগে ছুটিটা পাই।\""}, {"t0": 5.0, "t1": 7.4, "text": "তুমি বলতে, \"সবকিছুতেই"}, {"t0": 7.4, "t1": 10.4, "text": "এত দেরি করো কেন?\""}, {"t0": 11.9, "t1": 14.3, "text": "এখন ছুটি পেলেই ভাবি,"}, {"t0": 14.3, "t1": 16.2, "text": "কোথাও ঘুরে আসি।"}, {"t0": 16.2, "t1": 19.1, "text": "তারপর আর ঠিক করা হয় না,"}, {"t0": 19.1, "t1": 22.0, "text": "কোন শহরে যাব আমি।"}, {"t0": 22.0, "t1": 24.6, "text": "আমরা কত কিছু ভেবেছি,"}, {"t0": 24.6, "t1": 26.5, "text": "কত কিছু বলা।"}, {"t0": 26.5, "t1": 28.7, "text": "কিছু কথা শেষ হয়েছে,"}, {"t0": 28.7, "t1": 30.0, "text": "কিছু রয়ে গেছে আধখানা।"}]}