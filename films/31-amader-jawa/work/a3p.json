{"7.5": [{"t0": 4.5, "t1": 7.2, "text": "একটা জায়গায় যাওয়ার কথা ছিল,"}, {"t0": 7.5, "t1": 8.8, "text": "মনে আছে?"}, {"t0": 9.5, "t1": 11.5, "text": "খুব দূরে কোথাও না।"}, {"t0": 12.5, "t1": 14.0, "text": "তুমি বলেছিলে,"}, {"t0": 14.5, "t1": 17.5, "text": "\"একদিন সময় করে যাব।\""}, {"t0": 18.5, "t1": 20.0, "text": "তারপর..."}, {"t0": 20.5, "t1": 22.5, "text": "সময় হলো।"}, {"t0": 23.5, "t1": 26.0, "text": "যাওয়া হলো না।"}], "22.5": [{"t0": 0.0, "t1": 2.8, "text": "\"একদিন সময় করে যাব।\""}, {"t0": 3.8, "t1": 5.2, "text": "তারপর..."}, {"t0": 5.5, "t1": 8.0, "text": "সময় হলো।"}, {"t0": 8.5, "t1": 11.0, "text": "যাওয়া হলো না।"}, {"t0": 17.8, "t1": 20.5, "text": "তোমার ফোনে রাখা ছিল"}, {"t0": 20.5, "t1": 23.5, "text": "কত জায়গার ছবি।"}, {"t0": 23.8, "t1": 27.0, "text": "কোথায় গেলে কী খাব আমরা,"}, {"t0": 27.0, "t1": 30.0, "text": "সবই জানতে তুমি।"}]}